alias funcNum R1;

if(funcNum==2) then //free User Area Page
	alias PID R2;
	R3=PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*PID+11;
	multipush(R1,R2,R3);
	R1=RELEASE_PAGE; //=2
	R2=R3;
	call MOD_2; //MEMORY_MANAGER
	multipop(R1,R2,R3);
endif;

if(funcNum==3) then //exit Process
	alias PID R2;
	multipush(R1,R2);
	R1=2; //funcNum for 
	//R2=R2; //for PID
	call MOD_1; // PROCESS_MANAGER
	multipop(R1,R2);
	multipush(R1,R2);
	R1=4; //funcNum for 
	//R2=R2; //for PID
	call MOD_1; // PROCESS_MANAGER
	multipop(R1,R2);
	[PROCESS_TABLE+PID*16+4]=TERMINATED;
endif;

if(funcNum==4) then //free Page Table
	[PTBR+0]=-1;
	[PTBR+1]="0000";
	[PTBR+2]=-1;
	[PTBR+3]="0000";
	alias num R4;
	num=4;
	while(num<16) do
		if([PTBR+num]!=-1) then
			multipush(R1,R2,R4);
			R1=RELEASE_PAGE; //=2
			R2=[PTBR+num];
			call MOD_2; //MEMORY_MANAGER
			multipop(R1,R2,R4);
			[PTBR+num+1]="0000";
		endif;
		num=num+2;
	endwhile;
endif;

return;
