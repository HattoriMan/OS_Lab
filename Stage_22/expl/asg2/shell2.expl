int main()
{
decl
    int t, pid, a;
    string input;
enddecl
begin
    a=1;
    while(a == 1) do
        t = exposcall("Write",-2,"-Command-");
        t = exposcall("Read",-1, input);
        if(input != "Shutdown") then
            pid = exposcall("Fork");
            if(pid < 0) then
                t = exposcall("Write",-2, "Fork Failure");
                continue;
            endif;
            if(pid != 0) then
                t = exposcall("Wait",pid);
            else
                t = exposcall("Exec",input);
                if(t != 0) then
                    t = exposcall("Write",-2, "BAD COMMAND");
                    break;
                endif;
            endif;
        else
            t = exposcall("Shutdown");
            break;
        endif;
    endwhile;
    return 0;
end
}
