//int14_22.spl

alias userSP R15;
userSP = SP;

alias PID R14;
PID = [SYSTEM_STATUS_TABLE+1];
[PROCESS_TABLE + PID*16 + 13] = SP;

SP = [PROCESS_TABLE + PID*16 + 11]*512;

alias fn R13;
fn=[[PTBR+2*(userSP-5)/512]*512+(userSP-5)%512];

if(fn==19) then //SemLock
	[PROCESS_TABLE+PID*16+9]=19; //Mode Flag
	R12=[[PTBR+2*(userSP-4)/512]*512+(userSP-4)%512]; //Semaphore descriptor index of semaphore entry in resource table
	R11=[PROCESS_TABLE+PID*16+11]*512+496; //Per process resource table
	if(R12>7 || R12<0 || [R11+R12*2]!=1) then  //not a valid index or not semaphore
		[[PTBR+2*(userSP-1)/512]*512+(userSP-1)%512]=-1; //set retVal =-1 if invalid
	else
		R10=[R11+R12*2+1]; //index of semaphore table
		while([SEMAPHORE_TABLE+R10*4]!=-1) do 
			[PROCESS_TABLE+PID*16+4]=WAIT_SEMAPHORE;
			[PROCESS_TABLE+PID*16+5]=R10;
			multipush(R15,R14,R13,R12,R11,R10);
			call MOD_5; //schedule another process
			multipop(R15,R14,R13,R12,R11,R10);
		endwhile;
		
		//only run when semaphore becomes free
		[PROCESS_TABLE+16*PID+4]=READY;
		[SEMAPHORE_TABLE+R10*4]=PID;
		[[PTBR+2*(userSP-1)/512]*512+(userSP-1)%512]=0; //set retVal =0 if invalid	
	endif;	
endif;

if(fn==20) then //SemUnlock
	[PROCESS_TABLE+PID*16+9]=20; //Mode Flag
	R12=[[PTBR+2*(userSP-4)/512]*512+(userSP-4)%512]; //Semaphore descriptor index of semaphore entry in resource table
	R11=[PROCESS_TABLE+PID*16+11]*512+496; //Per process resource table
	if(R12>7 || R12<0 || [R11+R12*2]!=1) then  //not a valid index or not semaphore
		[[PTBR+2*(userSP-1)/512]*512+(userSP-1)%512]=-1; //set retVal =-1 if invalid
	else
		R10=[R11+R12*2+1]; //index of semaphore table
		if([SEMAPHORE_TABLE+R10*4]!=PID) then
			[[PTBR+2*(userSP-1)/512]*512+(userSP-1)%512]=-2; //set retVal =-2 if invalid
		else
			[SEMAPHORE_TABLE+R10*4]=-1; ///* Unlock the semaphore. */
			R9=0;
			while(R9<16) do
				if([PROCESS_TABLE+R9*16+4]==WAIT_SEMAPHORE && [PROCESS_TABLE+R9*16+5]==R10) then
					[PROCESS_TABLE+R9*16+4]=READY;
				endif;
				R9=R9+1;
			endwhile;
			[[PTBR+2*(userSP-1)/512]*512+(userSP-1)%512]=0; //set retVal=0
		endif;
	endif;
endif;


[PROCESS_TABLE+PID*16+9]=0; //Mode Flag
SP=userSP;

ireturn;


















