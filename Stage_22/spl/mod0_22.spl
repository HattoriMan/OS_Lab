//mod0_22.spl

alias functionNum R1;
alias currentPID R2;

//for acquiring disk
if(R1==3) then
	//while ( disk is locked ){        /* Check the Status field in the Disk Status Table. */
	//    Set state of the process as ( WAIT_DISK , - );
	//    Call the switch_context() function from the Scheduler Module.
	//}
	//Lock the disk by setting PID and the status field in the Disk Status Table.
	//return;
	
	while([DISK_STATUS_TABLE+0]==1) do
		[PROCESS_TABLE+currentPID*16+4]=WAIT_DISK;
		multipush(R1,R2);
		call MOD_5;
		multipop(R1,R2);
	endwhile;
	[DISK_STATUS_TABLE+4]=currentPID;
	[DISK_STATUS_TABLE+0]=1; //status is set to lock the disk
	//return;
endif;

//for acquiring semaphore
if(R1==6) then //ACQUIRE_SEMAPHORE(=6)
	R15=0;
	R14=SEMAPHORE_TABLE;
	while(R15<MAX_SEM_COUNT && [R14+R15*4+1]!=0) do //to find unused semaphore, process count=0 //MAX_SEM_COUNT=32
		R15=R15+1;
	endwhile;
	if(R15==MAX_SEM_COUNT) then  //MAX_SEM_COUNT==32
		R0=-1; //retVal if no semaphore is free
	else
		//Set the PROCESS_COUNT to 1 and LOCKING_PID to -1.
		[R14+R15*4]=-1; //Locking PID
		[R14+R15*4+1]=1; //Process Count
		R0=R15;
	endif;
endif;

//for releasing semaphore
if(R1==7) then //RELEASE_SEMAPHORE(=7) //R3 has semaphore index 
	if([SEMAPHORE_TABLE+R3*4]==currentPID) then //if semaphore is locked by current process
		[SEMAPHORE_TABLE+R3*4]=-1; //Unlock semaphore
		
		//loop through the process table{ /*wake up processes blocked by the semaphore */
		//   	if (the process state is ( WAIT_SEMAPHORE, SEMTABLEINDEX ) ){
	    //     	Set state of process as (READY , _ )
	    // 	} 
		//}
		
		R15=0;
		R14=PROCESS_TABLE;
		while(R15<16) do
			if([R14+R15*16+4]==WAIT_SEMAPHORE && [R14+R15*16+5]==R3) then
				[R14+R15*16+4]=READY;
			endif;
			R15=R15+1;
		endwhile;
		
		//Decrement the process count of the semaphore in the semaphore table.
		///* When the count becomes 0, the semaphore is free. */
		[SEMAPHORE_TABLE+R3*4+1]=[SEMAPHORE_TABLE+R3*4+1]-1;
	endif;
endif;

//for acquiring terminal
if(R1==8) then
	//while terminal is allocated to other processes wait
	while([TERMINAL_STATUS_TABLE+0]==1) do
		[PROCESS_TABLE+(currentPID)*16+4]=WAIT_TERMINAL;
		//change state of current PID to WAIT_TERMINAL
		multipush(R1,R2);
		call MOD_5; //scheduler
		//pop stack to gain context, would run after terminal is released 
		multipop(R1,R2);
	endwhile;
	[TERMINAL_STATUS_TABLE+0]=1; //change terminal status
	[TERMINAL_STATUS_TABLE+1]=currentPID; //change PID in terminal status table
	//return;
endif;

//for releasing terminal
if(R1==9) then
	if(currentPID==[TERMINAL_STATUS_TABLE+1]) then
		[TERMINAL_STATUS_TABLE+0]=0; //change status to mark release of terminal
		alias PID R15;
		PID=0;
		//Update the STATE to READY for all processes (with valid PID) which have STATE as WAIT_TERMINAL.
		while(PID<16) do
			if([PROCESS_TABLE+(PID)*16+4]==WAIT_TERMINAL) then
				[PROCESS_TABLE+(PID)*16+4]=READY;
			endif;
			PID=PID+1;
		endwhile;
		R0=0;
		//return;
	else
		R0=-1; //as this process is trying to release terminal without even acquiring it
		//return;
	endif;
endif;

return;
