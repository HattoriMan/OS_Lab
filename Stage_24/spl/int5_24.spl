// Save user stack pointer
alias userSP R1;
userSP = SP;

// Get syscall number from user stack
alias syscall R2;
syscall=[[PTBR+2*((userSP-5)/512)]*512+((userSP-5)%512)];

// Locate current process table entry
alias process R3;
process = PROCESS_TABLE+16*[SYSTEM_STATUS_TABLE+1];

// Save USER SP
[process+13]=SP;

// Switch to kernel stack
SP=[process+11]*512;



// ======================================================
// ================= OPEN SYSTEM CALL ===================
// ======================================================

if (syscall == INT_OPEN) then

    // Set MODE_FLAG = OPEN
    [process + 9] = R2; //as R2 stores Syscall of OPEN (==2)

    // ================= ARGUMENTS =================

    alias FileName R4;
    FileName=[[PTBR+2*((userSP-4)/512)]*512+((userSP-4)%512)];


    // ================= FIND FREE ENTRY IN RESOURCE TABLE FOR STROING FILE DESCRIPTOR =================
    alias PerProcess R5; //Maps to the perProcess Resource Table
    PerProcess=[process+11]*512+RESOURCE_TABLE_OFFSET; // RESOURCE_TABLE_OFFSET is just the constant defined for 496

    R6 = 0;
    while (R6<8) do
        if ([PerProcess+2*R6]==-1) then
            break;
        endif;
        R6=R6+1;
    endwhile;

    // If No free entry found in Resource table for file descriptor

    if (R6 >= 8) then
        [[PTBR+2*((userSP-1)/512)]*512+((userSP-1)%512)]=-3; //retVal

    else
        // Call Resource Manager: OPEN Function

		////////////////////////////////////////////////////////////////////////////////
        multipush(R1, R2, R3, R4, R5, R6);
        R1 = OPEN;
        R2 = FileName;
        call MOD_3;
        multipop(R1, R2, R3, R4, R5, R6);
		////////////////////////////////////////////////////////////////////////////////
		
        if (R0 < 0) then
        	// If Error from OPEN
            [[PTBR+2*((userSP-1)/512)]*512+((userSP-1)%512)]=R0; //retVal = error code received from open function 
        else
            // Store file descriptor mapping
            R7=PerProcess+2*R6;
            [R7]=FILE;
            [R7+1]=R0;

            // Return descriptor
            [[PTBR+2*((userSP-1)/512)]*512+((userSP-1)%512)]=R6;

        endif;

    endif;
    
    [process+9]=0; //set MODE flag
    SP = userSP;
    ireturn;
endif;


// ======================================================
// ================= CLOSE SYSTEM CALL ==================
// ======================================================

if (syscall == INT_CLOSE) then

    // Set MODE_FLAG = CLOSE
    [process+9]=syscall; //=R2 stores syscall number(==3)

    // ================= GET ARGUMENT =================

    alias Filedesc R2;
    Filedesc=[[PTBR+2*((userSP-4)/512)]*512+((userSP-4)%512)];

    // Validate descriptor range
    if (R2 > 7 || R2 < 0) then
        [[PTBR+2*((userSP-1)/512)]*512+((userSP-1)%512)]=-1; //retVal
    else
        // Locate per-process entry
        alias PerProcessEntry R4;
        PerProcessEntry=[process+11]*512+RESOURCE_TABLE_OFFSET+2*Filedesc; //entry of file in resource table

        // Ensure descriptor refers to file
        if ([PerProcessEntry] != FILE) then //FILE=0
            [[PTBR+2*((userSP-1)/512)]*512+((userSP-1)%512)]=-1; //retVal
        else
            // Call Resource Manager CLOSE
            
            //////////////////////////////////////////////////////////////////////////////
            multipush(R1, R2, R3, R4);
            R1 = CLOSE;
            R2 = [PerProcessEntry+1];
            call MOD_3;
            multipop(R1, R2, R3, R4);
			//////////////////////////////////////////////////////////////////////////////
			
            // Invalidate/Free entry in resource table
            [PerProcessEntry]=-1;
            [[PTBR+2*((userSP-1)/512)]*512+((userSP-1)%512)]=0; //retVal
        endif;
    endif;

    [process+9]=0;
    SP = userSP;
    ireturn;
endif;

















