//idle
loadi(69,11);
loadi(70,12);

//module 7
loadi(54,67);
loadi(55,68);

//set SP to kernel stack of idle process as it is shared by both idle process and boot module
SP = 82*512-1;

call BOOT_MODULE;

PTBR = PAGE_TABLE_BASE;
PTLR = 10;

[PTBR + 0] = -1;
[PTBR + 1] = "0000";
[PTBR + 2] = -1;
[PTBR + 3] = "0000";
[PTBR + 4] = -1;
[PTBR + 5] = "0000";
[PTBR + 6] = -1;
[PTBR + 7] = "0000";
[PTBR + 8] = 69;
[PTBR + 9] = "0100";
[PTBR + 10] = 70;
[PTBR + 11] = "0100";
[PTBR + 12] = -1;
[PTBR + 13] = "0000";
[PTBR + 14] = -1;
[PTBR + 15] = "0000";
[PTBR + 16] = 81;
[PTBR + 17] = "0110";
[PTBR + 18] = -1;
[PTBR + 19] = "0000";

//user area page address for idle
[PROCESS_TABLE + 11] = 82;
//the process ID of the process = 0
[PROCESS_TABLE + 1] = 0;
//set state to created
[PROCESS_TABLE + 4] = RUNNING;
//set uptr to 8*512
[PROCESS_TABLE + 13] = 8*512;
//set kptr to 0
[PROCESS_TABLE + 12] = 0;
//set ptbr
[PROCESS_TABLE + 14] = PTBR;
//set ptlr
[PROCESS_TABLE + 15] = PTLR;

//set current process ID in system status table
[SYSTEM_STATUS_TABLE + 1] = 0;

//save ip for starting of idle process in user sp
[81*512] = [69*512+1];

SP = 8*512;

ireturn;
