[PROCESS_TABLE + [SYSTEM_STATUS_TABLE+1]*16 + 9] = 7; //set mode flag to store syscall 7 for read

alias userSP R0;
userSP=SP;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE+1]*16 + 13] = userSP; 

SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE+1]*16 + 11]*512-1; //switch from user stack to kernel stack

alias fileDesc R1;
fileDesc = [[PTBR + 2*((userSP-4)/512)]*512+((userSP-4)%512)];

//breakpoint;

if(fileDesc!=-1) then
	//store retVal=-1
	[[PTBR + 2*((userSP-1)/512)]*512+((userSP-1)%512)]=-1;
else
	alias wordAdd R4;
	wordAdd = [[PTBR + 2*((userSP-3)/512)]*512+((userSP-3)%512)];
	multipush(R0,R1,R4);
	R1=4; //func number of read in R1
	R2=[SYSTEM_STATUS_TABLE+1];
	R3=wordAdd;
	//breakpoint;
	//Call device manager module
	call MOD_4;
	//There is no return value for terminal Read.
	multipop(R0,R1,R4);
	//store retVal=0 as to indicate success
	[[PTBR + 2*((userSP-1)/512)]*512+((userSP-1)%512)]=0;
endif;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE+1]*16 + 9] = 0; //set mode flag to store 0  before returning to user program
//restore user stack
SP=userSP;
ireturn;
